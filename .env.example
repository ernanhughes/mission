# Mission Control reads these only if you set them in the process environment.
# Do not put real secrets in this file.

# Optional runtime overrides
# MISSION_CONTROL_DATA_DIR=C:\Projects\mission\data
# MISSION_CONTROL_HOST=127.0.0.1
# MISSION_CONTROL_PORT=8790
# MISSION_CONTROL_LOG_LEVEL=INFO
# MISSION_CONTROL_MONITOR=1

# Optional AI provider key. Configure the variable NAME in Settings; never
# place the key in the database or this example file.
# OPENAI_API_KEY=
