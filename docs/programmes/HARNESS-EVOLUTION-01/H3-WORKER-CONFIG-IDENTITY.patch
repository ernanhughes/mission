+test("configuration identity includes requested engine, model, and policy", async () => {
+  const ledger = tempLedger()
+  const worker = service(ledger)
+  const initial = { backend: "harness-fixture-v1", model: "model-alpha", policy: "policy-alpha" }
+  for (const execution of [
+    initial,
+    { ...initial, backend: "missing-executor" },
+    { ...initial, model: "model-beta" },
+    { ...initial, policy: "policy-beta" },
+  ]) {
+    await worker.run({ objective: "fixture", execution })
+  }
+  const rows = ledger.read().records
+  expect(new Set(rows.map(row => row.resolved.configuration_digest)).size).toBe(4)
+  expect(rows[2]?.resolved.resolved_model_route).toBeNull()
+  expect(rows[3]?.resolved.resolved_model_policy).toBeNull()
+  const { configuration_digest_schema, configuration_digest, ...resolved } = rows[0]!.resolved
+  expect(configuration_digest_schema).toBe("worker.execution-configuration.v1")
+  expect(configuration_digest).toBe(executionDigest({
+    schema_version: configuration_digest_schema, requested: rows[0]!.requested, resolved,
+  }))
+})
