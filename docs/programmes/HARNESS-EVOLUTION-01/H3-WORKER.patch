diff --git a/src/core/worker.ts b/src/core/worker.ts
index 6909380..4922958 100644
--- a/src/core/worker.ts
+++ b/src/core/worker.ts
@@ -10,6 +10,8 @@ import type { UsageLedger } from "../models/usage-ledger.js"
 import type { UsageCallsLedger } from "../models/usage-calls.js"
 import type { ExternalOpenCodeSource } from "../models/external-opencode.js"
 import { resolveWindow } from "../models/cost-time.js"
+import type { ExecutionLedger } from "./execution-ledger.js"
