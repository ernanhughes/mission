+test("requested token caps affect the digest without implying provider enforcement", async () => {
+  const ledger = tempLedger()
+  const worker = service(ledger)
+  for (const cap of [120, 240]) {
+    await worker.run({ objective: "fixture", parameters: { max_output_tokens: cap } })
+  }
+  const [a, b] = ledger.read().records
+  expect(a?.resolved.configuration_digest).not.toBe(b?.resolved.configuration_digest)
+  expect(a?.resolved.output_budget).toEqual({
+    requested_max_output_tokens: 120,
+    post_profile_max_output_tokens: 120,
+    effective_max_output_tokens: null,
+    enforcement: "UNKNOWN",
+  })
+  expect(a?.input_digest).toBeNull()
+  expect(a?.output_digest).toBeNull()
+})
